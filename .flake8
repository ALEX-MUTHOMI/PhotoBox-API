[flake8]
# PhotoBox Flake8 Configuration (repo root — used by host CI and local runs)
#
# Historical spacing / wrapping debt is ignored so flake8 stays focused on
# correctness (unused imports, undefined names) and egregious line length.
# Do not raise max-line-length or re-enable ignored codes to “greenwash” CI;
# fix real F/E402 issues in the modules that introduce them.

max-line-length = 140

exclude =
    */migrations/*,
    __pycache__,
    .git,
    .venv,
    venv,
    env,
    dist,
    build,
    static,
    static_root,
    media_root,
    fixtures,
    htmlcov,
    .pytest_cache,
    photobox-docs-site,
    node_modules,
    artifacts,
    manage.py

per-file-ignores =
    */tests/*.py: S101, PLR2004
    */settings.py: F401, F403
    */__init__.py: F401
    */gallery/management/commands/seed_db.py: F541
    app/settings.py: F401, F403

extend-ignore =
    E111,
    E114,
    E117,
    E203,
    E221,
    E231,
    E261,
    E301,
    E302,
    E303,
    E304,
    E305,
    W291,
    W292,
    W293,
    W391,
    F541,
    W503,
    W504
