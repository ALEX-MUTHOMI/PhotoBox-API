# ─────────────────────────────────────────────────────────────────────────────
# PhotoBox API — Environment Variables Reference
#
# USAGE:
#   cp .env.example .env
#   Edit .env with your actual values
#
# SECURITY:
#   - NEVER commit .env to git (it is in .gitignore)
#   - In CI: these values are injected from GitHub Secrets
#   - In production: use your secrets manager (Doppler / AWS Secrets Manager)
# ─────────────────────────────────────────────────────────────────────────────

# ── Django Core ──────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-50-char-random-string-in-production
# DJANGO_SECRET_KEY may be used instead of SECRET_KEY in production secret managers.
DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string-in-production
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Database (PostgreSQL 16) ─────────────────────────────────────────────────
DB_HOST=db
DB_NAME=photobox_dev
DB_USER=photobox_dev_user
DB_PASS=change-me-strong-db-password

# ── Redis (Celery Broker + Cache) ────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_PASSWORD=change-me-redis-password

# ── Cloudflare R2 Storage ────────────────────────────────────────────────────
# IAM scope: s3:PutObject + s3:GetObject ONLY (never s3:DeleteObject)
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET_NAME=photobox-uploads
CLOUDFLARE_R2_DOMAIN=<your-r2-public-domain>.r2.dev
CLOUDFLARE_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_WEBHOOK_SECRET=a-strong-random-secret-for-hmac-verification

# ── Cloudinary (CDN Fetch Proxy — no SDK uploads) ────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name

# ── Lemon Squeezy Billing ────────────────────────────────────────────────────
LEMON_SQUEEZY_API_KEY=your-lemonsqueezy-api-key
LEMON_SQUEEZY_STORE_ID=your-store-id
# Dual-secret rotation: promote secondary to primary when rotating
LEMON_SQUEEZY_WEBHOOK_SECRET_PRIMARY=your-primary-webhook-signing-secret
LEMON_SQUEEZY_WEBHOOK_SECRET_SECONDARY=your-retiring-webhook-signing-secret

# ── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Email ────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=PhotoBox <no-reply@photobox.app>

# ── Security ─────────────────────────────────────────────────────────────────
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key
ENABLE_LEGACY_R2_WEBHOOK=1
IP_HASH_SALT=a-unique-random-string-for-ip-hashing
CELERY_RESULT_EXPIRES=3600

# ── Logging / Observability ──────────────────────────────────────────────────
DJANGO_LOG_LEVEL=INFO
SENTRY_DSN=
# APP_VERSION=photobox-api@1.0.0
